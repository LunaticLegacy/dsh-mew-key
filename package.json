{
  "name": "dsh-mew-key",
  "version": "0.1.5",
  "description": "Mew Key — an inline paw button in the composer toolbar; one click makes the agent meow once and say what it is doing.",
  "license": "MIT",
  "author": "Mew Key contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LunaticLegacy/dsh-mew-key.git"
  },
  "homepage": "https://github.com/LunaticLegacy/dsh-mew-key#readme",
  "bugs": {
    "url": "https://github.com/LunaticLegacy/dsh-mew-key/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "meow"
  ],
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./lib/client.js": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "src/client.tsx",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "preview.html"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "node ./build.mjs",
    "test": "node --test ./tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0 <0.3.0"
  }
}